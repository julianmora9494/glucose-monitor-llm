# --- LibreLinkUp Authentication -----------------------------------------------
LIBRE_REGION=LA                        # Region: LA, EU, US, AP
LIBRE_EMAIL=your_email@example.com
LIBRE_PASSWORD=your_password

# --- Telegram Bot -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_CAREGIVER_CHAT_ID=optional_caregiver_chat_id

# --- Azure OpenAI -------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Thresholds glucemicos (mg/dL) -------------------------------------------
LOW_THRESHOLD=70
VERY_LOW_THRESHOLD=55
HIGH_THRESHOLD=180
VERY_HIGH_THRESHOLD=250

# --- Rate of change thresholds ------------------------------------------------
RAPID_DROP_MGDL_MIN=-2.0
RAPID_RISE_MGDL_MIN=2.0
EXTREME_DROP_MGDL_MIN=-3.0
EXTREME_RISE_MGDL_MIN=3.0
RAPID_DROP_PERCENT=-12.0
RAPID_RISE_PERCENT=12.0

# --- Timing -------------------------------------------------------------------
POLL_SECONDS=120                       # Polling cada 2 minutos
PERSISTENCE_MINUTES=20                 # Tiempo para alerta persistente
NO_DATA_ALERT_MINUTES=15               # Sin datos: alerta
COOLDOWN_MINUTES=20                    # Cooldown entre alertas iguales

# --- Output -------------------------------------------------------------------
SHOW_PLOT=0
SAVE_PLOT=1

# --- FastAPI / Dashboard -----------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8888
API_URL=http://localhost:8888           # Local; en Railway sera https://tu-app.railway.app
DASHBOARD_PORT=8501
CORS_ORIGINS=                           # Origenes extra separados por coma (opcional)

# --- Base de datos ------------------------------------------------------------
DATABASE_URL=data/glucose.duckdb        # Local; en Railway usar /data/glucose.duckdb (volumen)
